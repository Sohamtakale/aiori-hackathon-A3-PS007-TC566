# Mayfly lab topology. Sourced by the lab scripts; keep it plain KEY=value.
#
# Everything lives in network namespaces. The bridge and the monitored veth
# ends sit in the "switch" namespace $SW_NS, NOT in the host namespace, so the
# host's interfaces, NetworkManager, firewalld and docker never see the lab.

SW_NS=sw
BRIDGE=br0

DEVICES="d1 d2 d3 d4 d5"
TENANT_A="d1 d2 d3"
TENANT_B="d4 d5"
ROUTER_NS=router
ATTACKER_NS=attacker

# ULA prefix ("Mayfl" in hex) - not globally routable, and nothing routes it anyway.
LAB_PREFIX=fd4d:6179:666c:1::/64
ROUTER_LL=fe80::1
ROUTER_ADDR=fd4d:6179:666c:1::1

# Locally administered MACs so the lab is identical on every rebuild.
# 02:4d:46 = "MF"; last byte: 01-05 devices, fe router, 66 attacker.
MAC_PREFIX=02:4d:46:00:00

# Runtime files. /run/radvd is labelled radvd_var_run_t by the Fedora SELinux
# policy, so the confined radvd may read its config and write its pid/log there.
STATE_DIR=/run/mayfly-lab
RADVD_DIR=/run/radvd
RADVD_CONF=$RADVD_DIR/mayfly-lab.conf
RADVD_PID=$RADVD_DIR/mayfly-lab.pid
RADVD_LOG=$RADVD_DIR/mayfly-lab.log

# RA timing: fast enough for experiments.
RA_MIN_INTERVAL=3
RA_MAX_INTERVAL=10
RA_ROUTER_LIFETIME=600
